    <Product specieID="NgPA" />
    <forwardRate>0.00036</forwardRate>
    <reverseRate>36.e-3</reverseRate>
    <Q10>0.2</Q10>
  </Reaction>


  <Reaction name="pNgPA_bind" id="pNgPA_bind">
