<?xml version="1.0"?>
<ReactionScheme> 
  <Specie name="Ca" id="Ca" kdiff="100" kdiffunit="mu2/s" />
  <Specie name="CaOut" id="CaOut" kdiff="10" kdiffunit="mu2/s" />
  <Specie name="CaOutLeak" id="CaOutLeak" kdiff="0"
	  kdiffunit="mu2/s" />
  <Specie name="Leak" id="Leak" kdiff="0" kdiffunit="mu2/s" />

  <Specie name="fixedbuffer" id="fixedbuffer" kdiff="0" kdiffunit="mu2/s"/>
  <Specie name="fixedbufferCa" id="fixedbufferCa" kdiff="0" kdiffunit="mu2/s"/>
  <Specie name="Calbin" id="Calbin" kdiff="9.3" kdiffunit="mu2/s" />
  <Specie name="CalbinC" id="CalbinC" kdiff="9.3" kdiffunit="mu2/s" />
  
 
  <Specie name="ncx" id="ncx" kdiff="0" kdiffunit="mu2/s" />
  <Specie name="ncxCa" id="ncxCa" kdiff="0" kdiffunit="mu2/s" />
  <!-- model and constants from Paszty et al 2015 DOI:  10.1126/scisignal.2005672-->
  <Specie name="pmca1a" id="pmca1a" kdiff="0" kdiffunit="mu2/s" />
  <Specie name="pmca1aCa" id="pmca1aCa" kdiff="0" kdiffunit="mu2/s" />
  <Specie name="CaMCa4pmca1a" id="CaMCa4pmca1a" kdiff="0" kdiffunit="mu2/s" />
  <Specie name="CaMCa4pmca1aCa" id="CaMCa4pmca1aCa" kdiff="0" kdiffunit="mu2/s"/>
  <Specie name="CaMpmca1a" id="CaMpmca1a" kdiff="0" kdiffunit="mu2/s" /> 

  <Specie name="PP2BCaMCa4"            id="PP2BCaMCa4"           kdiff=".61"    kdiffunit="mu2/s"/>
  <!-- <Specie name="PP1"            id="PP1"           kdiff="0.1"    kdiffunit="mu2/s"/> -->
  <Specie name="PKCc"            id="PKCc"           kdiff="6.61"    kdiffunit="mu2/s"/>
  <Specie name="CaPKCc"            id="CaPKCc"           kdiff="6.61"    kdiffunit="mu2/s"/>

  <Specie name="CaPKC"            id="CaPKC"           kdiff="6.61"    kdiffunit="mu2/s"/>
  <Specie name="Ca2PKC"            id="Ca2PKC"           kdiff="6.61"    kdiffunit="mu2/s"/>

  <Specie name="Ca2PKC_act"          id="Ca2PKC_act"         kdiff="6.61"    kdiffunit="mu2/s"/>
  <Specie name="Ca2PKC_actNg"          id="PKCCa2Ng"         kdiff="6.61"    kdiffunit="mu2/s"/>
  <Specie name="Ca2PKC_actNgPA"          id="PKCCa2NgPA"         kdiff="0"    kdiffunit="mu2/s"/>

  <Specie name="Ng" id="Ng" kdiff="5" kdiffunit="mu2/s" />
  <Specie name="pNg" id="pNg" kdiff="5" kdiffunit="mu2/s" />
  <Specie name="pNgPP2BCaMCa4"            id="pNgPP2BCaMCa4"           kdiff="0"    kdiffunit="mu2/s"/>

  <Specie name="NgCaM" id="NgCaM" kdiff="3" kdiffunit="mu2/s" />
  <Specie name="PA" id="PA" kdiff="0" kdiffunit="mu2/s" />
  <Specie name="NgPA" id="NgPA" kdiff="0" kdiffunit="mu2/s" />
  <Specie name="pNgPA" id="pNgPA" kdiff="0" kdiffunit="mu2/s" />
  
  <!-- -->
  <Specie name="CaM" id="CaM" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaM1N" id="CaM1N" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaM2N" id="CaM2N" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaM1C" id="CaM1C" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaM1C1N" id="CaM1C1N" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaM1C2N" id="CaM1C2N" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaM2C" id="CaM2C" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaM2C1N" id="CaM2C1N" kdiff="4" kdiffunit="mu2/s" />
  <Specie name="CaMCa4"  id="CaMCa4" kdiff="4" kdiffunit="mu2/s" />

  <!--Calmodulin-->
  
  <!-- 4 Ca bound Calmodulin-->
  <!-- -->

  <!--Hindered cytoplasmic diffusion of
	  inositol trisphosphate restricts its cellular range of
	  action     George D. Dickinson1,*, Kyle L. Ellefsen1,
	  Silvina Ponce Dawson2, John E. Pearson3, and Ian Parker1,4
	  Sci signalling -->
  <!--*************************************************************************
  Now, the reactions themselves   SAME means params are same in both files
  **************************************************************************-->
  <!--I. *********** Ca pump and buffer rxns  ************* -->
  <!-- i: Ca pump high affinity -    Ca + pmca <-> pmcaCa  SAME-->

  <!--pmca1a is based on pmca4a from Paszty et al 2015 Science Signaling-->
  <Reaction name = "Ca_pump1a_1" id="Ca_pump1a_1">
    <Reactant specieID="Ca"/>
    <Reactant specieID="pmca1a"/>
    <Product specieID="pmca1aCa"/>

    <forwardRate>10e-6</forwardRate>
    <reverseRate>50e-3</reverseRate>
  </Reaction>

 
  <Reaction name = "Ca_pump1a_2" id="Ca_pump1a_2">
    <Reactant specieID="pmca1aCa"/>
    <Product specieID="pmca1a"/>
    <Product specieID="CaOut"/>
    
    <forwardRate>12e-3</forwardRate>
    <reverseRate>0</reverseRate>
  </Reaction>

  <Reaction name = "Ca_CaMCa4pump1a_1" id="Ca_CaMCa4pump1a_1">
    <Reactant specieID="Ca"/>
    <Reactant specieID="CaMCa4pmca1a"/>
    <Product specieID="CaMCa4pmca1aCa"/>

    <forwardRate>50e-6</forwardRate>
    <reverseRate>10e-3</reverseRate>
  </Reaction>

 
  <Reaction name = "Ca_CaMCa4pump1a_2" id="Ca_CaMCa4pump1a_2">
    <Reactant specieID="CaMCa4pmca1aCa"/>
    <Product specieID="CaMCa4pmca1a"/>
    <Product specieID="CaOut"/>
    
    <forwardRate>30e-3</forwardRate>
    <reverseRate>0</reverseRate>
  </Reaction>


  

  <Reaction name = "CaMCa4pump1a_bind" id="CaMCa4pump1a_bind">
    <Reactant specieID="CaMCa4"/>
    <Reactant specieID="pmca1a"/>
    <Product specieID="CaMCa4pmca1a"/>

    <forwardRate>0.8e-6</forwardRate>
    <reverseRate>0.02e-3</reverseRate>
  </Reaction>

  


  <Reaction name = "CaMCa4pump1a_Ca_unbind" id="CaMCa4pump1a_Ca_unbind">
    <Reactant specieID="CaMCa4pmca1a"/>
    <Product specieID="CaMpmca1a"/>
    <Product specieID="Ca" power="4"/>
    <forwardRate>0.0957e-3</forwardRate>
    <reverseRate>1.006e-15</reverseRate>
  </Reaction>

 
 

  <Reaction name = "CaMpump1a_Ca_unbind" id="CaMpump1a_Ca_unbind">
    <Reactant specieID="CaMpmca1a"/>
    <Product specieID="pmca1a"/>
    <Product specieID="CaM"/>
    <forwardRate>0.0614e-3</forwardRate>

  </Reaction>


  
  <!-- iii: Ca pump low affinity -    Ca + ncx <-> ncxCa  SAME-->
  <Reaction name = "Ca_pump2a" id="Ca_pump2a">
    <Reactant specieID="Ca"/>
    <Reactant specieID="ncx"/>
    <Product specieID="ncxCa"/>
    
    <forwardRate>1.68e-5</forwardRate>
    <reverseRate>0.0112</reverseRate>
  </Reaction>
  
  <!-- iv: Ca pump low affinity -    ncxCa <-> ncx + CaOut   SAME-->
  <Reaction name = "Ca_pump2b" id="Ca_pump2b">
    <Reactant specieID="ncxCa"/>
    <Product specieID="ncx"/>
    <Product specieID="CaOut"/>

    <forwardRate>0.0056</forwardRate>
    <reverseRate>0</reverseRate>
  </Reaction>
  <!-- v: Ca leak -    CaOut + Leak <-> CaOutLeak  GQ RXN FILE, Leak is sm only-->
  <Reaction name = "Ca_leak1" id="Ca_leak1">
    <Reactant specieID="CaOut"/>
    <Reactant specieID="Leak"/>
    <Product specieID="CaOutLeak"/>

    <forwardRate>1.5e-6</forwardRate>
    <reverseRate>1.1e-3</reverseRate>
  </Reaction>

  <!-- vi: Ca leak -    CaOutLeak <-> Ca (inside) + Leak  -->
  <Reaction name = "Ca_leak2" id="Ca_leak2">
    <Reactant specieID="CaOutLeak"/>
    <Product specieID="Ca"/>
    <Product specieID="Leak"/>
    
    <forwardRate>1.1e-3</forwardRate>
    <reverseRate>0</reverseRate>
  </Reaction>


  
  <!-- vii: Ca Buffer    Ca + Calbindin <-> calbinC  SAME-->
  <Reaction name = "Ca_buffer" id="Ca_Buffer">
    <Reactant specieID="Ca"/>
    <Reactant specieID="Calbin"/>
    <Product specieID="CalbinC"/>

    <forwardRate>2.8e-5</forwardRate>
    <reverseRate>0.0196</reverseRate>
  </Reaction>
  <!-- fixed immobile buffer-->
  <Reaction name = "Ca_fixedbuffer" id="Ca_fixedBuffer">
    <Reactant specieID="Ca"/>
    <Reactant specieID="fixedbuffer"/>
    <Product specieID="fixedbufferCa"/>
    <forwardRate>0.004e-3</forwardRate>
    <reverseRate>20.0e-2</reverseRate>
    <Q10>0.2</Q10>
  </Reaction>

  <!-- Adapt Pepke's course model with rates fitted by Linkevicius et al 2026) -->
   <!--This is the C site-->
 

  <Reaction name="reaction1" id="reaction1">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM" />
    <Product specieID="CaM1C" />
    <forwardRate>2.137e-05</forwardRate>
    <reverseRate>0.0398</reverseRate>
  </Reaction>
  <Reaction name="reaction3" id="reaction3">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM1N" />
