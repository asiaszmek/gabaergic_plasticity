    <forwardRate>0.000955</forwardRate>
    <reverseRate>0.933</reverseRate>
  </Reaction>
  <Reaction name="reaction11" id="reaction11">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM1C2N" />
    <Product specieID="CaMCa4" />
    <forwardRate>0.000955</forwardRate>
    <reverseRate>0.933</reverseRate>
  </Reaction>
  <Reaction name="reaction13" id="reaction13">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM" />
    <Product specieID="CaM1N" />
    <forwardRate>0.010715</forwardRate>
    <reverseRate>794.328</reverseRate>
  </Reaction>
  <Reaction name="reaction15" id="reaction15">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM1N" />
    <Product specieID="CaM2N" />
    <forwardRate>0.00195</forwardRate>
    <reverseRate>3.63</reverseRate>
  </Reaction>
  <Reaction name="reaction17" id="reaction17">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM1C" />
    <Product specieID="CaM1C1N" />
    <forwardRate>0.010715</forwardRate>
    <reverseRate>794.328</reverseRate>
  </Reaction>
  <Reaction name="reaction19" id="reaction19">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM1C1N" />
    <Product specieID="CaM1C2N" />
    <forwardRate>0.00195</forwardRate>
    <reverseRate>3.63</reverseRate>
  </Reaction>
  <Reaction name="reaction21" id="reaction21">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM2C" />
    <Product specieID="CaM2C1N" />
    <forwardRate>0.010715</forwardRate>
    <reverseRate>794.328</reverseRate>
  </Reaction>
  <Reaction name="reaction23" id="reaction23">
    <Reactant specieID="Ca" />
    <Reactant specieID="CaM2C1N" />
    <Product specieID="CaMCa4" />
    <forwardRate>0.00195</forwardRate>
    <reverseRate>3.63</reverseRate>
  </Reaction>
  <!-- Kubota, Putkey, Waxham, 2007, Biophys J, 92:3848-3859, constants
       k5 and k_5-->
  <!--2a) CaM  + Ng
      <-> NgCaM -->
  <!--I step of the Neurogranin -->
  <Reaction name="NgCaM_bind" id="NgCaM_bind">
    <Reactant specieID="CaM" />
    <Reactant specieID="Ng" />
    <Product specieID="NgCaM" />
    <forwardRate>28.e-6</forwardRate>
    <reverseRate>36.e-3</reverseRate>
    <Q10>0.2</Q10>
  </Reaction>

<!-- kd = 83 nM 
https://doi.org/10.1042/BJ20061483
