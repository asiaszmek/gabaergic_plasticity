  </Reaction>
      

<!-- From Gallimore's model
-->
    <!-- PKCc + Ca    <->   CaPKCc  -->
    <Reaction name = "PKCc+Ca--CaPKCc" id="PKCc+Ca--CaPKCc">
        <Reactant specieID="Ca"      />
        <Reactant specieID="PKCc"              />
        <Product  specieID="CaPKCc"               />

        <forwardRate> 13.3e-6   </forwardRate>
        <reverseRate> 12e-3       </reverseRate>
    </Reaction>

    <Reaction name = "CaPKCc--CaPKC" id="CaPKCc--CaPKC">
        <Reactant specieID="CaPKCc"              />
        <Product  specieID="CaPKC"               />
        <forwardRate> 420e-3   </forwardRate>
        <reverseRate> 17e-3       </reverseRate>
    </Reaction>

    <Reaction name = "CaPKC+Ca--Ca2PKC" id="CaPKC+Ca--Ca2PKC">
        <Reactant specieID="Ca"      />
        <Reactant specieID="CaPKC"              />
        <Product  specieID="Ca2PKC"               />

        <forwardRate> 1e-6   </forwardRate>
        <reverseRate> 12e-3       </reverseRate>
    </Reaction>

    <Reaction name = "Ca2PKC--Ca2PKC_act" id="Ca2PKC--Ca2PKC_act">
        <Reactant specieID="Ca2PKC"              />
        <Product  specieID="Ca2PKC_act"               />
        <forwardRate> 3e-3   </forwardRate>
        <reverseRate> 5e-3       </reverseRate>
    </Reaction>
    
  <!-- Ca2PKC_act+Ng    <->   Ca2PKC_actNg  -->
    <Reaction name = "Ca2PKC_act +Ng--Ca2PKC_actNg" id="Ca2PKC_act+Ng--Ca2PKC_actNg">
        <Reactant specieID="Ca2PKC_act"           />
        <Reactant specieID="Ng"              />
        <Product  specieID="Ca2PKC_actNg"               />

        <forwardRate> 2.48e-5   </forwardRate>
        <reverseRate> 0.15e-03        </reverseRate>
    </Reaction>
    <Reaction name = "Ca2PKC_actNgphos" id="Ca2PKC_actNgphos">
        <Reactant specieID="Ca2PKC_actNg"           />
        <Product  specieID="pNg"              />
        <Product  specieID="Ca2PKC_act"               />

        <forwardRate> 3.571e-3   </forwardRate>
        <reverseRate> 0        </reverseRate>
    </Reaction>
  <!-- Ca2PKC_act+Ng    <->   Ca2PKC_actNg  -->
    <Reaction name = "Ca2PKC_act +NgPA--Ca2PKC_actNg" id="Ca2PKC_act+NgPA--Ca2PKC_actNg">
        <Reactant specieID="Ca2PKC_act"           />
        <Reactant specieID="NgPA"              />
        <Product  specieID="Ca2PKC_actNgPA"               />

        <forwardRate> 2.48e-5   </forwardRate>
        <reverseRate> 0.15e-03        </reverseRate>
    </Reaction>
    <Reaction name = "Ca2PKC_actNgPAphos" id="Ca2PKC_actNgPAphos">
        <Reactant specieID="Ca2PKC_actNgPA"           />
