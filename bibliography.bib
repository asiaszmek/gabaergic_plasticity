@article {soce_ip3r,
article_type = {journal},
title = {Regulation of store-operated $\mathrm{Ca^{2+}}$ entry by {IP}\textsubscript{3} receptors independent of their ability to release $\mathrm{Ca^{2+}}$},
author = {Chakraborty, Pragnya and Deb, Bipan Kumar and Arige, Vikas and Musthafa, Thasneem and Malik, Sundeep and Yule, David I and Taylor, Colin W and Hasan, Gaiti},
editor = {Lewis, Richard S and Swartz, Kenton J and Machaca, Khaled and Demaurex, Nicolas},
