@Article{cells9122655,
AUTHOR = {McDaid, John and Mustaly-Kalimi, Sarah and Stutzmann, Grace E.},
TITLE = {$\mathrm{Ca^{2+}}$ Dyshomeostasis Disrupts Neuronal and Synaptic Function in Alzheimer’s Disease},
JOURNAL = {Cells},
VOLUME = {9},
YEAR = {2020},
NUMBER = {12},
ARTICLE-NUMBER = {2655},
URL = {https://www.mdpi.com/2073-4409/9/12/2655},
PubMedID = {33321866},
ISSN = {2073-4409},
ABSTRACT = {$\mathrm{Ca^{2+}}$ homeostasis is essential for multiple neuronal functions and thus, $\mathrm{Ca^{2+}}$ dyshomeostasis can lead to widespread impairment of cellular and synaptic signaling, subsequently contributing to dementia and Alzheimer’s disease (AD). While numerous studies implicate $\mathrm{Ca^{2+}}$ mishandling in AD, the cellular basis for loss of cognitive function remains under investigation. The process of synaptic degradation and degeneration in AD is slow, and constitutes a series of maladaptive processes each contributing to a further destabilization of the $\mathrm{Ca^{2+}}$ homeostatic machinery. $\mathrm{Ca^{2+}}$ homeostasis involves precise maintenance of cytosolic $\mathrm{Ca^{2+}}$ levels, despite extracellular influx via multiple synaptic $\mathrm{Ca^{2+}}$ channels, and intracellular release via organelles such as the endoplasmic reticulum (ER) via ryanodine receptor (RyRs) and IP3R, lysosomes via transient receptor potential mucolipin channel (TRPML) and two pore channel (TPC), and mitochondria via the permeability transition pore (PTP). Furthermore, functioning of these organelles relies upon regulated inter-organelle $\mathrm{Ca^{2+}}$ handling, with aberrant signaling resulting in synaptic dysfunction, protein mishandling, oxidative stress and defective bioenergetics, among other consequences consistent with AD. With few effective treatments currently available to mitigate AD, the past few years have seen a significant increase in the study of synaptic and cellular mechanisms as drivers of AD, including $\mathrm{Ca^{2+}}$ dyshomeostasis. Here, we detail some key findings and discuss implications for future AD treatments.},
DOI = {10.3390/cells9122655}
}



@article{presyn_RyR_LTP,

AUTHOR={Arias-Cavieres, Alejandra  and Barrientos, Genaro C.  and Sánchez, Gina  and Elgueta, Claudio  and Muñoz, Pablo  and Hidalgo, Cecilia },

TITLE={Ryanodine Receptor-Mediated Calcium Release Has a Key Role in Hippocampal LTD Induction},

JOURNAL={Frontiers in Cellular Neuroscience},

VOLUME={12},

YEAR={2018},

URL={https://www.frontiersin.org/journals/cellular-neuroscience/articles/10.3389/fncel.2018.00403},

DOI={10.3389/fncel.2018.00403},

ISSN={1662-5102},

ABSTRACT={<p>The induction of both long-term potentiation (LTP) and long-term depression (LTD) of synaptic transmission entails pre- and postsynaptic $\mathrm{Ca^{2+}}$ signals, which represent transient increments in cytoplasmic free $\mathrm{Ca^{2+}}$ concentration. In diverse synapse types, $\mathrm{Ca^{2+}}$ release from intracellular stores contributes to amplify the $\mathrm{Ca^{2+}}$ signals initially generated by activation of neuronal $\mathrm{Ca^{2+}}$ entry pathways. Here, we used hippocampal slices from young male rats to evaluate whether pharmacological activation or inhibition of $\mathrm{Ca^{2+}}$ release from the endoplasmic reticulum (ER) mediated by ryanodine receptor (RyR) channels modifies LTD induction at Schaffer collateral-CA1 synapses. Pre-incubation of slices with ryanodine (1 μM, 1 h) or caffeine (1 mM, 30 min) to promote {RyR}-mediated $\mathrm{Ca^{2+}}$ release facilitated LTD induction by low frequency stimulation (LFS), but did not affect the amplitude of synaptic transmission, the profiles of field excitatory postsynaptic potentials (fEPSP) or the paired-pulse (PP) responses. Conversely, treatment with inhibitory ryanodine (20 μM, 1 h) to suppress {RyR}-mediated $\mathrm{Ca^{2+}}$ release prevented LTD induction, but did not affect baseline synaptic transmission or PP responses. Previous literature reports indicate that LTD induction requires presynaptic CaMKII activity. We found that 1 h after applying the LTD induction protocol, slices displayed a significant increase in CaMKII phosphorylation relative to the levels exhibited by un-stimulated (naïve) slices. In addition, LTD induction (1 h) enhanced the phosphorylation of the presynaptic protein Synapsin I at a CaMKII-dependent phosphorylation site, indicating that LTD induction stimulates presynaptic CaMKII activity. Pre-incubation of slices with 20 μM ryanodine abolished the increased CaMKII and Synapsin I phosphorylation induced by LTD, whereas naïve slices pre-incubated with inhibitory ryanodine displayed similar CaMKII and Synapsin I phosphorylation levels as naïve control slices. We posit that inhibitory ryanodine suppressed LTD-induced presynaptic CaMKII activity, as evidenced by the suppression of Synapsin I phosphorylation induced by LTD. Accordingly, we propose that presynaptic {RyR}-mediated $\mathrm{Ca^{2+}}$ signals contribute to LTD induction at Schaffer collateral-CA1 synapses.</p>}}

@article{RAMIREZ2021102399,
title = {Ryanodine receptor-mediated $\mathrm{Ca^{2+}}$ release and atlastin-2 {GTP}ase activity contribute to $\mathrm{IP_3}$-induced dendritic $\mathrm{Ca^{2+}}$ signals in primary hippocampal neurons},
journal = {Cell Calcium},
volume = {96},
pages = {102399},
year = {2021},
issn = {0143-4160},
doi = {https://doi.org/10.1016/j.ceca.2021.102399},
url = {https://www.sciencedirect.com/science/article/pii/S0143416021000531},
author = {Omar A. Ramírez and Alex Córdova and Mauricio Cerda and Pedro Lobos and Steffen Härtel and Andrés Couve and Cecilia Hidalgo},
keywords = {Ca transients, Ca release channels, Endoplasmic reticulum, Ca-induced Ca release, Rat hippocampus},
abstract = {Neuronal $\mathrm{Ca^{2+}}$ signals are fundamental for synaptic transmission and activity-dependent changes in gene expression. Voltage-gated $\mathrm{Ca^{2+}}$ channels and N-methyl-d-aspartate receptors play major roles in mediating external $\mathrm{Ca^{2+}}$ entry during action potential firing and glutamatergic activity. Additionally, the inositol-1,4,5-trisphosphate receptor (IP3R) and the ryanodine receptor (RyR) channels expressed in the endoplasmic reticulum (ER) also contribute to the generation of $\mathrm{Ca^{2+}}$ signals in response to neuronal activity. The ER forms a network that pervades the entire neuronal volume, allowing intracellular $\mathrm{Ca^{2+}}$ release in dendrites, soma and presynaptic boutons. Despite its unique morphological features, the contributions of ER structure and of ER-shaping proteins such as atlastin - an ER enriched GTPase that mediates homotypic ER tubule fusion - to the generation of $\mathrm{Ca^{2+}}$ signals in dendrites remains unreported. Here, we investigated the contribution of {RyR}-mediated $\mathrm{Ca^{2+}}$ release to IP3-generated $\mathrm{Ca^{2+}}$ signals in dendrites of cultured hippocampal neurons. We also employed GTPase activity-deficient atlastin-2 (ATL2) mutants to evaluate the potential role of atlastin on $\mathrm{Ca^{2+}}$ signaling and ER-resident $\mathrm{Ca^{2+}}$ channel distribution. We found that pharmacological suppression of RyR channel activity increased the rising time and reduced the magnitude and propagation of IP3-induced $\mathrm{Ca^{2+}}$ signals. Additionally, ATL2 mutants induced specific ER morphological alterations, delayed the onset and increased the rising time of IP3-evoked $\mathrm{Ca^{2+}}$ signals, and caused RyR2 and IP3R1 aggregation and RyR2 redistribution. These results indicate that both RyR and ATL2 activity regulate IP3-induced $\mathrm{Ca^{2+}}$ signal dynamics through {RyR}-mediated $\mathrm{Ca^{2+}}$-induced $\mathrm{Ca^{2+}}$ release, ER shaping and RyR2 distribution.}
}

@article{RyR_acti_contributes_to_nuclear_ca_release,
author = {Pedro Lobos  and Alex Córdova  and Ignacio Vega-Vásquez  and Omar A. Ramírez  and Tatiana Adasme  and Jorge Toledo  and Mauricio Cerda  and Steffen Härtel  and Andrea Paula-Lima  and Cecilia Hidalgo },
title = {{RyR}-mediated $\mathrm{Ca^{2+}}$ release elicited by neuronal activity induces nuclear $\mathrm{Ca^{2+}}$ signals, {CREB} phosphorylation, and {Npas4}/{RyR2} expression},
journal = {Proceedings of the National Academy of Sciences},
volume = {118},
number = {33},
pages = {e2102265118},
year = {2021},
doi = {10.1073/pnas.2102265118},
URL = {https://www.pnas.org/doi/abs/10.1073/pnas.2102265118},
eprint = {https://www.pnas.org/doi/pdf/10.1073/pnas.2102265118},
abstract = {The expression of genes involved in hippocampal synaptic plasticity, learning, and memory requires that $\mathrm{Ca^{2+}}$ signals generated in spines, dendrites, or the soma by neuronal stimulation reach the nucleus. Here, we report that stimulation of hippocampal neurons induces $\mathrm{Ca^{2+}}$ release mediated by RyR2 channels, which contributes to nuclear $\mathrm{Ca^{2+}}$ signal generation. Suppression of {RyR}-mediated $\mathrm{Ca^{2+}}$ release inhibited the activity-induced phosphorylation of the nuclear transcriptional regulator CREB and the expression of the Npas4 transcription factor and RyR2, which play crucial roles in hippocampal memory processes. We propose that {RyR}-mediated $\mathrm{Ca^{2+}}$ release induced by neuronal stimulation, by promoting the sequential generation of nuclear $\mathrm{Ca^{2+}}$ signals, CREB phosphorylation, and Npas4/RyR2 up-regulation, plays a significant role in hippocampal synaptic plasticity and spatial memory processes. The expression of several hippocampal genes implicated in learning and memory processes requires that $\mathrm{Ca^{2+}}$ signals generated in dendritic spines, dendrites, or the soma in response to neuronal stimulation reach the nucleus. The diffusion of $\mathrm{Ca^{2+}}$ in the cytoplasm is highly restricted, so neurons must use other mechanisms to propagate $\mathrm{Ca^{2+}}$ signals to the nucleus. Here, we present evidence showing that $\mathrm{Ca^{2+}}$ release mediated by the ryanodine receptor (RyR) channel type-2 isoform (RyR2) contributes to the generation of nuclear $\mathrm{Ca^{2+}}$ signals induced by gabazine (GBZ) addition, glutamate uncaging in the dendrites, or high-frequency field stimulation of primary hippocampal neurons. Additionally, GBZ treatment significantly increased cyclic adenosine monophosphate response element binding protein (CREB) phosphorylation—a key event in synaptic plasticity and hippocampal memory—and enhanced the expression of Neuronal Per Arnt Sim domain protein 4 (Npas4) and RyR2, two central regulators of these processes. Suppression of {RyR}-mediated $\mathrm{Ca^{2+}}$ release with ryanodine significantly reduced the increase in CREB phosphorylation and the enhanced Npas4 and RyR2 expression induced by GBZ. We propose that {RyR}-mediated $\mathrm{Ca^{2+}}$ release induced by neuronal activity, through its contribution to the sequential generation of nuclear $\mathrm{Ca^{2+}}$ signals, CREB phosphorylation, Npas4, and RyR2 up-regulation, plays a central role in hippocampal synaptic plasticity and memory processes.}}

