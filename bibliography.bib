doi = {10.7554/eLife.80447},
url = {https://doi.org/10.7554/eLife.80447},
abstract = {Loss of endoplasmic reticular (ER) $\mathrm{Ca^{2+}}$ activates store-operated $\mathrm{Ca^{2+}}$ entry (SOCE) by causing the ER localized $\mathrm{Ca^{2+}}$ sensor STIM to unfurl domains that activate Orai channels in the plasma membrane at membrane contact sites (MCS). Here, we demonstrate a novel mechanism by which the inositol 1,4,5 trisphosphate receptor (IP\textsubscript{3}R), an ER-localized IP\textsubscript{3}-gated $\mathrm{Ca^{2+}}$ channel, regulates neuronal SOCE. In human neurons, SOCE evoked by pharmacological depletion of ER-$\mathrm{Ca^{2+}}$ is attenuated by loss of IP\textsubscript{3}Rs, and restored by expression of IP\textsubscript{3}Rs even when they cannot release $\mathrm{Ca^{2+}}$, but only if the IP\textsubscript{3}Rs can bind IP\textsubscript{3}. Imaging studies demonstrate that IP\textsubscript{3}Rs enhance association of STIM1 with Orai1 in neuronal cells with empty stores; this requires an IP\textsubscript{3}-binding site, but not a pore. Convergent regulation by IP\textsubscript{3}Rs, may tune neuronal SOCE to respond selectively to receptors that generate IP\textsubscript{3}.},
keywords = {human neural progenitors cells, human neuronal cells, endoplasmic reticulum, plasma membrane contact sites, Orai, STIM, Gq, IP3Rs},
journal = {eLife},
issn = {2050-084X},
publisher = {eLife Sciences Publications, Ltd},
}
