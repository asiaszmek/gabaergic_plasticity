	  kdiffunit="mu2/s" />
  
  <!-- CaM, CaMCa4 and PP2B Binding -->
  <!--1) CaM  + 2Ca
      <-> CaMCa2 -->
  <!--This is the C site-->
  <!--1A) CaM  + 2Ca <-> CaM2C GQ RXN FILE, C or N can bind first-->
  
 <!-- Stefan, Edelstein and Le Novere 2008 PNAS do not speed up Ca binding to PP2BCaM -->
  <!--4A) CaM2C    +   PP2B    <->  PP2BCaM2C (in xpp: k33c=1 k_33c=0.3) -->
  <Reaction name = "CaM+PP2B--PP2BCaM reac" id="CaM+PP2B--PP2BCaM_id">
    <Reactant specieID="CaM"                 />
    <Reactant specieID="PP2B"                   />
    <Product  specieID="PP2BCaM"             />
    
    <forwardRate> 4.6e-6 </forwardRate>
    <reverseRate>  1.2e-6    </reverseRate>
  </Reaction>


